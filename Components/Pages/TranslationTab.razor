@page "/translation-tab"
@layout EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Web
@using LiveTranslation.Engine
@using Teams_Translation_App.Services
@inject NavigationManager Nav
@inject MeetingSessionManager Sessions
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>KID AI Live Translation</PageTitle>

<style>
    /* ── Reset ───────────────────────────────────────────────────── */
    html, body, #app, .page, article, main {
        margin: 0 !important;
        padding: 0 !important;
        height: 100% !important;
        overflow: hidden !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    /* ── Root container ──────────────────────────────────────────── */
    .tab-root {
        --header-height: 24px;
        --header-padding-y: 1px;
        --font-latest: 14px;
        --font-mid: 12px;
        --font-old: 10px;
        --font-active: 10px;
        --font-waiting: 11px;
        --font-popout-current: 14px;
        --font-popout-prev: 12px;
        --font-popout-waiting: 12px;
        display: flex;
        flex-direction: column;
        height: 100vh;
        width: 100%;
        max-width: 100%;
        padding: 0;
        box-sizing: border-box;
        overflow-x: hidden;
        position: relative;
        background: #0e0e16;
        font-family: 'Segoe UI', sans-serif;
        color: #ffffff;
    }

    html.teams-light .tab-root { background: #f5f5fa; color: #0e0e2e; }
    html.teams-contrast .tab-root { background: #000000; color: #ffffff; }

    .tab-root.font-small {
        --font-latest: 12px;
        --font-mid: 10px;
        --font-old: 9px;
        --font-active: 9px;
        --font-waiting: 10px;
        --font-popout-current: 12px;
        --font-popout-prev: 10px;
        --font-popout-waiting: 10px;
    }

    .tab-root.font-medium {
        --font-latest: 14px;
        --font-mid: 12px;
        --font-old: 10px;
        --font-active: 10px;
        --font-waiting: 11px;
        --font-popout-current: 14px;
        --font-popout-prev: 12px;
        --font-popout-waiting: 12px;
    }

    .tab-root.font-large {
        --font-latest: 16px;
        --font-mid: 14px;
        --font-old: 12px;
        --font-active: 12px;
        --font-waiting: 13px;
        --font-popout-current: 16px;
        --font-popout-prev: 14px;
        --font-popout-waiting: 14px;
    }

    /* ── Minimal header ──────────────────────────────────────────── */
    .header-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
        min-height: var(--header-height);
        margin: 0;
        padding: var(--header-padding-y) 0;
        border-bottom: 1px solid #1e1e2e;
        background: #0e0e1e;
    }

    .header-spacer {
        margin-right: auto;
        min-width: 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        height: 22px;
        border-radius: 999px;
        border: 1px solid;
        padding: 0 8px;
        font-size: 11px;
        line-height: 1;
        white-space: nowrap;
        cursor: default;
    }
    .status-badge .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
    }

    .badge-live { color: #33aa77; background: #0a1a12; border-color: #1a3a22; }
    .badge-waiting { color: #555577; background: #0e0e1e; border-color: #22223a; }
    html.teams-light .badge-live { color: #228855; background: #e8f5e8; border-color: #aaddaa; }
    html.teams-light .badge-waiting { color: #9090b0; background: #ebebf5; border-color: #c0c0da; }
    html.teams-contrast .status-badge { color: #ffffff; background: #000000; border-color: #ffffff; }

    .icon-btn {
        width: 22px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 3px;
        border: 1px solid #2a2a44;
        background: #22223a;
        color: #6666aa;
        cursor: pointer;
        font-size: 12px;
        line-height: 1;
        flex-shrink: 0;
    }
    .icon-btn .btn-icon {
        font-size: 13px;
        line-height: 1;
    }
    .icon-btn:hover:not([disabled]) { background: #2a2a44; color: #8f8fd0; }
    .icon-btn.active { background: #2a3f88; color: #ccd4ff; border-color: #3a50a8; }
    .icon-btn[disabled] { opacity: 0.4; cursor: default; }
    html.teams-light .icon-btn { background: #d0d0e8; color: #606090; border-color: #b8b8d0; }
    html.teams-light .icon-btn:hover:not([disabled]) { background: #c6c6df; color: #505080; }
    html.teams-light .icon-btn.active { background: #2a3f88; color: #ccd4ff; border-color: #3a50a8; }
    html.teams-contrast .icon-btn { background: #000000; color: #ffffff; border-color: #ffffff; }
    html.teams-contrast .icon-btn.active { background: #ffffff; color: #000000; border-color: #ffffff; }

    html.teams-light .header-bar { border-bottom-color: #c4c4da; background: #eaeaf5; }
    html.teams-contrast .header-bar { border-bottom-color: #ffffff; background: #000000; }

    .tab-root.popout-mode {
        padding: 4px 8px;
    }
    .tab-root.popout-mode .header-bar {
        margin: -4px -8px 4px -8px;
        padding: 3px 8px;
        min-height: 20px;
        gap: 4px;
    }
    /* Smaller icon buttons in popout */
    .popout-mode .icon-btn {
        width: 20px;
        height: 20px;
        font-size: 10px;
        padding: 0;
    }
    .popout-mode .icon-btn .btn-icon {
        font-size: 11px;
    }
    /* Smaller badge in popout */
    .popout-mode .status-badge {
        font-size: 9px;
        height: 20px;
        padding: 0 6px;
        gap: 4px;
    }
    .popout-mode .status-badge .status-dot {
        width: 5px;
        height: 5px;
    }

    /* ── Settings overlay ─────────────────────────────────────────── */
    .settings-overlay {
        position: absolute;
        left: 0;
        right: 0;
        top: var(--header-height);
        bottom: 0;
        z-index: 10;
    }

    .settings-panel {
        position: absolute;
        top: 4px;
        right: 6px;
        width: min(360px, calc(100% - 12px));
        background: #0f1020;
        border: 1px solid #2a2a44;
        border-radius: 4px;
        padding: 8px;
        box-sizing: border-box;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .s-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
    }

    .s-lbl {
        min-width: 42px;
        font-size: 9px;
        color: #7777aa;
        letter-spacing: 0.02em;
        flex-shrink: 0;
    }

    .s-sel {
        flex: 1;
        min-width: 0;
        font-size: 10px;
        padding: 3px 4px;
        border-radius: 3px;
        border: 1px solid #22223a;
        background: #14142a;
        color: #aaaacc;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
        appearance: auto;
    }
    .s-sel:disabled { opacity: 0.35; cursor: default; }

    .detected-badge { font-size: 9px; color: #33aa77; letter-spacing: 0.03em; flex-shrink: 0; white-space: nowrap; }
    html.teams-light .detected-badge { color: #228855; }
    html.teams-contrast .detected-badge { color: #ffffff; }

    .s-pill {
        background: #14142a;
        color: #666688;
        border: 1px solid #22223a;
        border-radius: 10px;
        padding: 2px 8px;
        font-size: 10px;
        font-family: 'Segoe UI', sans-serif;
        cursor: pointer;
        line-height: 1.3;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .s-pill:hover:not([disabled]) { background: #20203a; color: #aaaacc; }
    .s-pill.active { background: #2a3f88; color: #ccd4ff; border-color: #3a50a8; }
    .s-pill[disabled] { opacity: 0.35; cursor: default; }

    .s-divider {
        height: 1px;
        margin: 4px 0 6px;
        background: #1e1e2e;
    }

    .s-action {
        width: 100%;
        height: 22px;
        border-radius: 3px;
        border: 1px solid #2a2a44;
        background: #1b1b31;
        color: #b2b2d6;
        font-size: 10px;
        margin-top: 5px;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
    }
    .s-action[disabled] { opacity: 0.35; cursor: default; }
    .s-start { background: #0f2a16; color: #7ad68c; border-color: #29543a; }
    .s-stop { background: #321313; color: #ef8f8f; border-color: #694040; }

    .attr-link {
        text-align: center;
        margin-top: 5px;
        padding-top: 4px;
        border-top: 1px solid #1a1a2a;
    }
    .attr-link a {
        font-size: 7px;
        color: #2a2a44;
        text-decoration: none;
    }
    .attr-link a:hover { color: #444466; }

    html.teams-light .settings-panel { background: #f1f1fa; border-color: #c4c4da; box-shadow: 0 8px 24px rgba(33, 33, 77, 0.18); }
    html.teams-light .s-lbl { color: #7070a0; }
    html.teams-light .s-sel { background: #e0e0f0; border-color: #c0c0da; color: #404060; }
    html.teams-light .s-pill { background: #e0e0f0; color: #606090; border-color: #c0c0da; }
    html.teams-light .s-pill:hover:not([disabled]) { background: #d0d0e8; color: #404070; }
    html.teams-light .s-pill.active { background: #4a5faa; color: #ffffff; border-color: #3a4f9a; }
    html.teams-light .s-divider { background: #c4c4da; }
    html.teams-light .s-action { background: #d9d9ec; color: #545487; border-color: #bfbfda; }
    html.teams-light .s-start { background: #e8f5e8; color: #228822; border-color: #aaddaa; }
    html.teams-light .s-stop { background: #fde8e8; color: #aa2222; border-color: #ddaaaa; }
    html.teams-light .attr-link a { color: #c0c0d8; }
    html.teams-light .attr-link a:hover { color: #9090b0; }

    html.teams-contrast .settings-panel,
    html.teams-contrast .s-sel,
    html.teams-contrast .s-pill,
    html.teams-contrast .s-action { background: #000000; color: #ffffff; border-color: #ffffff; box-shadow: none; }
    html.teams-contrast .s-pill.active { background: #ffffff; color: #000000; border-color: #ffffff; }
    html.teams-contrast .s-lbl { color: #ffffff; }
    html.teams-contrast .s-divider { background: #ffffff; }

    /* ── Committed area ──────────────────────────────────────────── */
    .committed-area-wrapper {
        position: relative;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }

    .committed-area {
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        gap: 2px;
        scrollbar-width: thin;
        scrollbar-color: #22223a transparent;
        box-sizing: border-box;
    }
    .committed-area::-webkit-scrollbar { width: 3px; }
    .committed-area::-webkit-scrollbar-thumb { background: #22223a; border-radius: 2px; }
    .committed-area::-webkit-scrollbar-track { background: transparent; }
    .committed-area .spacer { flex: 1; }

    /* Multi-tier fade — dark (default) */
    .line-latest {
        font-size: var(--font-latest);
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .line-mid {
        font-size: var(--font-mid);
        font-weight: 400;
        color: #8888aa;
        margin: 0;
        line-height: 1.4;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .line-old {
        font-size: var(--font-old);
        font-weight: 400;
        color: #3a3a5a;
        margin: 0;
        line-height: 1.4;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Multi-tier fade — light */
    html.teams-light .line-latest { color: #0e0e2e; }
    html.teams-light .line-mid { color: #606090; }
    html.teams-light .line-old { color: #aaaacc; }

    /* Multi-tier fade — high contrast */
    html.teams-contrast .line-latest { color: #ffffff; }
    html.teams-contrast .line-mid { color: #cccccc; }
    html.teams-contrast .line-old { color: #aaaaaa; }

    .waiting-msg {
        margin: auto 0;
        text-align: center;
        font-size: var(--font-waiting);
        color: #333355;
        line-height: 1.4;
    }
    html.teams-light .waiting-msg { color: #aaaacc; }
    html.teams-contrast .waiting-msg { color: #ffffff; }

    /* ── Scroll indicator ────────────────────────────────────────── */
    .scroll-indicator {
        position: absolute;
        bottom: 6px;
        right: 4px;
        font-size: 9px;
        padding: 2px 6px;
        border-radius: 3px;
        user-select: none;
        z-index: 1;
        pointer-events: none;
    }

    .scroll-indicator.live {
        color: #33aa77;
        background: transparent;
        pointer-events: none;
    }

    .scroll-indicator.jump {
        background: #1e1e3e;
        color: #aaaacc;
        border: 1px solid #33335a;
        cursor: pointer;
        pointer-events: auto;
    }

    html.teams-light .scroll-indicator.live { color: #228855; }
    html.teams-light .scroll-indicator.jump { background: #e0e0f0; color: #606090; border-color: #c0c0da; }
    html.teams-contrast .scroll-indicator.live { color: #ffffff; }
    html.teams-contrast .scroll-indicator.jump { background: #000000; color: #ffffff; border: 1px solid #ffffff; }

    /* ── Divider ─────────────────────────────────────────────────── */
    .divider {
        height: 1px;
        background: #1e1e2e;
        margin: 6px 0;
        flex-shrink: 0;
    }
    html.teams-light .divider { background: #c4c4da; }
    html.teams-contrast .divider { background: #ffffff; }

    /* ── Active area ─────────────────────────────────────────────── */
    .active-area {
        flex-shrink: 0;
        min-height: 32px;
        max-height: 80px;
        overflow-y: auto;
        overflow-x: hidden;
        background: #0a0a12;
        border-radius: 2px;
        padding: 2px 0;
        margin-bottom: 6px;
        scrollbar-width: thin;
        scrollbar-color: #22223a transparent;
    }
    .active-area::-webkit-scrollbar { width: 3px; }
    .active-area::-webkit-scrollbar-thumb { background: #22223a; border-radius: 2px; }
    .active-area::-webkit-scrollbar-track { background: transparent; }

    /* Auto-hide active-area dan divider kalau tinggi viewport terlalu kecil
       Threshold 200px: cukup untuk committed area saja */
    @@media (max-height: 200px) {
        .active-area { display: none; }
        .divider { display: none; }
    }
    html.teams-light .active-area { background: #eeeef8; }
    html.teams-contrast .active-area { background: #000000; }

    .active-text {
        font-size: var(--font-active);
        color: #444466;
        margin: 0;
        line-height: 1.5;
        white-space: pre-wrap;
        word-wrap: break-word;
        overflow-wrap: break-word;
        font-style: italic;
    }
    html.teams-light .active-text { color: #9090c0; }
    html.teams-contrast .active-text { color: #aaaaaa; }

    /* Pop out inline caption area */
    .popout-caption-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 6px 10px;
        gap: 4px;
        overflow: hidden;
        min-height: 0;
    }

    .popout-prev-line {
        font-size: var(--font-popout-prev);
        font-weight: 400;
        color: #555577;
        margin: 0;
        line-height: 1.4;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .popout-current-line {
        font-size: var(--font-popout-current);
        margin: 0;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    .popout-current-line.is-committed {
        font-weight: 700;
        color: #ffffff;
        font-style: normal;
    }

    .popout-current-line.is-active {
        font-weight: 400;
        color: #aaaacc;
        font-style: italic;
    }

    .popout-waiting {
        font-size: var(--font-popout-waiting);
        color: #333355;
        margin: 0;
        text-align: center;
        padding: 20px 0;
    }

    html.teams-light .popout-prev-line { color: #9090b0; }
    html.teams-light .popout-current-line.is-committed { color: #0e0e2e; }
    html.teams-light .popout-current-line.is-active { color: #606090; }
    html.teams-light .popout-waiting { color: #aaaacc; }

    html.teams-contrast .popout-prev-line { color: #aaaaaa; }
    html.teams-contrast .popout-current-line.is-committed { color: #ffffff; }
    html.teams-contrast .popout-current-line.is-active { color: #cccccc; }
    html.teams-contrast .popout-waiting { color: #ffffff; }

    /* Pop out: hide separate active area and divider */
    .popout-mode .active-area {
        display: none;
    }
    .popout-mode .divider {
        display: none;
    }

</style>

<div class="tab-root @(_isPopout ? "popout-mode" : "") @GetFontClass()">
    <div class="header-bar">
        <span class="header-spacer"></span>

        <span class="status-badge @(_engineIsRunning ? "badge-live" : "badge-waiting")"
              title="@(_engineIsRunning ? "Live translation active" : "Waiting for audio stream")"
              aria-label="@(_engineIsRunning ? "Live translation active" : "Waiting for audio stream")">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-text">@(_engineIsRunning ? "Live" : "Waiting")</span>
        </span>

        @if (!_isPopout)
        {
            <button class="icon-btn"
                    aria-label="Open in pop out window"
                    title="Open in pop out window"
                    @onclick="OpenPopout">
                <span class="btn-icon" aria-hidden="true">⧉</span>
            </button>
        }

        <button class="icon-btn @(_isSettingsOpen ? "active" : "")"
                aria-label="Settings"
                title="Settings"
                @onclick="ToggleSettings">
            <span class="btn-icon" aria-hidden="true">⚙</span>
        </button>

        @if (_isPopout)
        {
            <button class="icon-btn"
                    aria-label="Close pop out"
                    title="Close pop out"
                    @onclick="ClosePopout">
                <span class="btn-icon" aria-hidden="true">✕</span>
            </button>
        }
    </div>

    @if (_isSettingsOpen)
    {
        <div class="settings-overlay" @onclick="CloseSettings">
            <div class="settings-panel" @onclick:stopPropagation="true">
                <div class="s-row">
                    <span class="s-lbl">Input</span>
                    <select class="s-sel" disabled="@_isSwitching"
                            value="@_selectedInputLang"
                            @onchange="OnInputLangChange">
                        @foreach (var option in _inputOptions)
                        {
                            <option value="@option.code">@option.label</option>
                        }
                    </select>
                    @if (_selectedInputLang == "auto" && !string.IsNullOrEmpty(_detectedLang))
                    {
                        <span class="detected-badge">(@_detectedLang.ToUpperInvariant())</span>
                    }
                </div>
                <div class="s-row">
                    <span class="s-lbl">Output</span>
                    <select class="s-sel" disabled="@_isSwitching"
                            value="@_selectedOutputLang"
                            @onchange="OnOutputLangChange">
                        @foreach (var option in _outputOptions)
                        {
                            <option value="@option.code">@option.label</option>
                        }
                    </select>
                </div>
                <div class="s-row">
                    <span class="s-lbl">Font</span>
                    <select class="s-sel"
                            value="@_selectedFontSize"
                            @onchange="OnFontSizeChange">
                        @foreach (var option in _fontOptions)
                        {
                            <option value="@option.code">@option.label</option>
                        }
                    </select>
                </div>
                <div class="s-divider"></div>
                <div class="s-row">
                    <span class="s-lbl">Mode</span>
                    <button class="s-pill @(_engineMode == TranslationMode.SttOpenAI ? "active" : "")"
                            disabled="@_isSwitching"
                            @onclick='() => SetMode(TranslationMode.SttOpenAI)'>STT+AI</button>
                    <button class="s-pill @(_engineMode == TranslationMode.Direct ? "active" : "")"
                            disabled="@_isSwitching"
                            @onclick='() => SetMode(TranslationMode.Direct)'>Direct</button>
                </div>
                <div class="s-divider"></div>
                <button class="s-action"
                        disabled="@(_committedLines.Count == 0)"
                        @onclick="CopyTranscript">
                    @(_copyConfirm ? "✓ Copied" : "Copy transcript")
                </button>
                <button class="s-action @(_engineIsRunning ? "s-stop" : "s-start")"
                        disabled="@_isSwitching"
                        @onclick="ToggleEngine">
                    @(_engineIsRunning ? "■ Stop engine" : "▶ Start engine")
                </button>
                <div class="attr-link">
                    <a href="https://www.flaticon.com/free-icons/languages"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="Languages icons created by Freepik - Flaticon">
                        Icon: Freepik · Flaticon
                    </a>
                </div>
            </div>
        </div>
    }

    @if (_isPopout)
    {
        <div class="popout-caption-area">
            @if (_committedLines.Count > 0 || !string.IsNullOrEmpty(_activeText))
            {
                <p class="popout-prev-line"
                   aria-label="Previous caption line"
                   aria-live="polite">@_popoutPrevLine</p>
                <p class="popout-current-line @_popoutCurrentLineClass"
                   aria-label="Current caption line"
                   aria-live="polite">
                    @_popoutCurrentLine
                </p>
            }
            else
            {
                <p class="popout-waiting">Waiting for audio stream...</p>
            }
        </div>
    }
    else
    {
        <div class="committed-area-wrapper">
            <div class="committed-area" @ref="_committedAreaRef" @onscroll="OnCommittedScroll">
                <div class="spacer"></div>
                @if (_committedLines.Count == 0 && !_engineIsRunning)
                {
                    <p class="waiting-msg">Waiting for audio stream...</p>
                }
                @for (int i = 0; i < _committedLines.Count; i++)
                {
                    int distFromEnd = _committedLines.Count - 1 - i;
                    string lineClass = distFromEnd == 0 ? "line-latest"
                                     : distFromEnd == 1 ? "line-mid"
                                     : "line-old";
                    <p class="@lineClass">@_committedLines[i]</p>
                }
            </div>
        </div>

        <div class="divider"></div>

        <div class="active-area">
            <p class="active-text">@_activeText</p>
        </div>
    }

</div>

