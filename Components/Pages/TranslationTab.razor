    private void AppendCommitted(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        AppendCommittedUnit(text);
        if (_committedLines.Count > 0)
            _lastCommittedText = _committedLines[^1];
        while (_committedLines.Count > CommittedMaxLines)
            _committedLines.RemoveAt(0);
    }

    private void HandleIncomingActive(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            ResetActiveTracking();
            return;
        }

        var normalized = NormalizeActiveText(text);
        if (string.IsNullOrWhiteSpace(normalized))
        {
            ResetActiveTracking();
            return;
        }

        var now = DateTime.UtcNow;
        if (!string.Equals(normalized, _activeLastSnapshot, StringComparison.Ordinal))
        {
            _activeLastSnapshot = normalized;
            _activeLastChangedAt = now;
        }

        if (string.IsNullOrWhiteSpace(_activeRawText))
        {
            _activeRollingRemainder = normalized;
        }
        else if (normalized.StartsWith(_activeRawText, StringComparison.Ordinal))
        {
            var delta = normalized.Substring(_activeRawText.Length).TrimStart();
            if (!string.IsNullOrWhiteSpace(delta))
                _activeRollingRemainder = string.IsNullOrWhiteSpace(_activeRollingRemainder)
                    ? normalized
                    : $"{_activeRollingRemainder} {delta}".Trim();
            else if (string.IsNullOrWhiteSpace(_activeRollingRemainder))
                _activeRollingRemainder = normalized;
        }
        else
        {
            _activeRollingRemainder = normalized;
        }

        _activeRawText = normalized;
        if (_engineMode != TranslationMode.SttOpenAI)
            PromoteCommittedFromActive(now);
        _activeText = NormalizeActiveText(_activeRollingRemainder);
    }

    private void ResetActiveTracking()
    {
        _activeText = "";
        _activeRawText = "";
        _activeRollingRemainder = "";
        _activeLastSnapshot = "";
        _activeLastChangedAt = DateTime.UtcNow;
    }

    private void PromoteCommittedFromActive(DateTime nowUtc)
    {
        while (TryTakeCompleteSentenceChunk(ref _activeRollingRemainder, out var sentence))
        {
            if (!string.IsNullOrWhiteSpace(sentence))
                EnqueueCommitted(sentence);
        }

        if (TryTakeFallbackChunk(ref _activeRollingRemainder, nowUtc, out var chunk))
        {
            if (!string.IsNullOrWhiteSpace(chunk))
                EnqueueCommitted(chunk);
        }
    }

    private void EnqueueCommitted(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        bool shouldDrain = false;
        lock (_committedQueueLock)
        {
            if (_disposeCts.IsCancellationRequested) return;
            _committedQueue.Enqueue(text.Trim());
            if (!_draining)
            {
                _draining = true;
                shouldDrain = true;
            }
        }
        if (shouldDrain)
            _ = InvokeAsync(DrainCommittedQueue);
    }

    private async Task DrainCommittedQueue()
    {
        try
        {
            while (!_disposeCts.IsCancellationRequested)
            {
                string? text = null;
                lock (_committedQueueLock)
                {
                    if (_disposeCts.IsCancellationRequested)
                    {
                        _draining = false;
                        return;
                    }
                    if (_committedQueue.Count == 0)
                    {
                        _draining = false;
                        return;
                    }
                    text = _committedQueue.Dequeue();
                }

                if (_disposeCts.IsCancellationRequested)
                    break;
                AppendCommitted(text);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(CommittedRenderDelayMs, _disposeCts.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // Component is disposing; stop draining gracefully.
        }
        finally
        {
            lock (_committedQueueLock)
            {
                _draining = false;
            }
        }
    }

    private void AppendCommittedUnit(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        text = text.Trim();
        if (!ContainsNonLatinScript(text) && WordCount(text) < CommittedMinWords) return;
        if (TryMergeWithExistingCommitted(text, out var ri, out var rt, out var skip))
        {
            if (skip) return;
            if (ri >= 0) _committedLines[ri] = rt;
            return;
        }
        _committedLines.Add(text);
    }

    private string StripAlreadyCommittedOverlap(string text)
    {
        if (string.IsNullOrWhiteSpace(_lastCommittedText) || _committedLines.Count == 0)
            return text;
        var t = text.Trim();
        int start = Math.Max(0, _committedLines.Count - CommittedOverlapLookbackLines);
        for (int i = _committedLines.Count - 1; i >= start; i--)
        {
            var committed = _committedLines[i].Trim();
            if (string.IsNullOrWhiteSpace(committed) || committed.Length < 10) continue;
            if (string.Equals(t, committed, StringComparison.OrdinalIgnoreCase)) return "";
            if (t.StartsWith(committed, StringComparison.OrdinalIgnoreCase))
                return t.Substring(committed.Length).TrimStart(' ', ',', '.', ';', '\u3001', '\uff0c');

            bool nonLatin = ContainsNonLatinScript(committed) || ContainsNonLatinScript(t);
            if (nonLatin)
            {
                int overlap = FindSuffixPrefixOverlap(committed, t);
                if (overlap >= NonLatinMinOverlapChars)
                {
                    int shorter = Math.Min(committed.Length, t.Length);
                    if (shorter > 0 && (double)overlap / shorter >= NonLatinMinOverlapRatio)
                        return t.Substring(overlap).TrimStart(' ', ',', '.', ';', '\u3001', '\uff0c');
                }
                // Non-Latin scripts here are dominated by no-space writing systems;
                // skip word-split overlap checks that rely on whitespace boundaries.
                continue;
            }

            var cWords = committed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            var tWords = t.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            int maxOverlap = Math.Min(cWords.Length, Math.Min(tWords.Length, 8));
            for (int overlap = maxOverlap; overlap >= 3; overlap--)
            {
                bool match = true;
                for (int k = 0; k < overlap; k++)
                {
                    var cw = NormalizeWordForCompare(cWords[cWords.Length - overlap + k]);
                    var tw = NormalizeWordForCompare(tWords[k]);
                    if (!string.Equals(cw, tw, StringComparison.OrdinalIgnoreCase))
                    { match = false; break; }
                }
                if (match)
                    return string.Join(" ", tWords, overlap, tWords.Length - overlap).Trim();
            }
        }
        return t;
    }

    private static int FindSuffixPrefixOverlap(string committed, string incoming)
    {
        if (string.IsNullOrWhiteSpace(committed) || string.IsNullOrWhiteSpace(incoming)) return 0;
        var c = committed.Length > NonLatinOverlapScanMaxChars
            ? committed[^NonLatinOverlapScanMaxChars..]
            : committed;
        var i = incoming.Length > NonLatinOverlapScanMaxChars
            ? incoming[..NonLatinOverlapScanMaxChars]
            : incoming;

        int max = Math.Min(c.Length, i.Length);
        for (int len = max; len >= NonLatinMinOverlapChars; len--)
        {
            if (c.AsSpan(c.Length - len, len)
                    .Equals(i.AsSpan(0, len), StringComparison.OrdinalIgnoreCase))
                return len;
        }
        return 0;
    }

    private bool TryMergeWithExistingCommitted(string text,
        out int index, out string replacement, out bool shouldSkip)
    {
        index = -1; replacement = text; shouldSkip = false;
        if (_committedLines.Count == 0) return false;
        int bestIndex = -1, bestPriority = 0;
        string bestReplacement = text;
        for (int i = _committedLines.Count - 1; i >= 0; i--)
        {
            var existing = _committedLines[i].Trim();
            if (string.IsNullOrWhiteSpace(existing)) continue;
            if (string.Equals(existing, text, StringComparison.OrdinalIgnoreCase))
            { shouldSkip = true; return true; }
            if (text.StartsWith(existing, StringComparison.OrdinalIgnoreCase))
            { if (bestPriority < 2) { bestIndex = i; bestPriority = 2; bestReplacement = text; } continue; }
            if (existing.StartsWith(text, StringComparison.OrdinalIgnoreCase))
            { shouldSkip = true; return true; }
            if (IsNearDuplicate(existing, text, 0.82))
            {
                if (text.Length > existing.Length)
                { if (bestPriority < 2) { bestIndex = i; bestPriority = 2; bestReplacement = text; } }
                else { shouldSkip = true; return true; }
                continue;
            }
            if (IsLikelyRevisionOf(existing, text))
            {
                if (text.Length >= existing.Length)
                { if (bestPriority < 2) { bestIndex = i; bestPriority = 2; bestReplacement = text; } }
                else { shouldSkip = true; return true; }
            }
        }
        if (bestPriority > 0) { index = bestIndex; replacement = bestReplacement; return true; }
        return false;
    }

    private static bool ContainsNonLatinScript(string text)
    {
        foreach (var c in text)
        {
            if (c >= 0x3000 && c <= 0x9FFF) return true; // CJK, Japanese
            if (c >= 0x1780 && c <= 0x17FF) return true; // Khmer
            if (c >= 0x1000 && c <= 0x109F) return true; // Myanmar/Burmese
            if (c >= 0x0E80 && c <= 0x0EFF) return true; // Lao
            if (c >= 0x0E00 && c <= 0x0E7F) return true; // Thai
            if (c >= 0x0B80 && c <= 0x0BFF) return true; // Tamil
            if (c >= 0xAC00 && c <= 0xD7AF) return true; // Hangul Syllables
            if (c >= 0x1100 && c <= 0x11FF) return true; // Hangul Jamo
        }
        return false;
    }

    private static int WordCount(string text) =>
        string.IsNullOrWhiteSpace(text) ? 0
        : text.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private static string NormalizeActiveText(string text)
        => string.Join(" ", (text ?? "").Trim().Split(
            new[] { ' ', '\t', '\r', '\n' },
            StringSplitOptions.RemoveEmptyEntries));

    private static bool IsSentenceTerminal(char c)
        => c is '.' or '!' or '?' or '\u3002' or '\uff01' or '\uff1f' or '\u17D4' or '\u17D5' or '\u0964';

    private static bool IsSoftBoundary(char c)
        => c is ',' or ';' or ':' or '，' or '、' or '；' or '：';

    private static bool EndsAtSemanticBoundary(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        var trimmed = text.TrimEnd();
        if (trimmed.Length == 0) return false;
        var last = trimmed[^1];
        return IsSentenceTerminal(last) || IsSoftBoundary(last);
    }

    private static bool TryTakeCompleteSentenceChunk(ref string text, out string chunk)
    {
        chunk = "";
        if (string.IsNullOrWhiteSpace(text)) return false;
        var t = text.Trim();
        int splitAt = -1;
        for (int i = 0; i < t.Length; i++)
        {
            if (!IsSentenceTerminal(t[i])) continue;
            if (i == t.Length - 1)
            {
                splitAt = i + 1;
                break;
            }
            if (char.IsWhiteSpace(t[i + 1]))
            {
                splitAt = i + 1;
                break;
            }
        }

        if (splitAt <= 0) return false;

        var candidate = t[..splitAt].Trim();
        var remainder = t[splitAt..].TrimStart();
        if (string.IsNullOrWhiteSpace(candidate)) return false;
        if (!ContainsNonLatinScript(candidate) && WordCount(candidate) < CommittedMinWords) return false;

        chunk = candidate;
        text = remainder;
        return true;
    }

    private bool TryTakeFallbackChunk(ref string text, DateTime nowUtc, out string chunk)
    {
        chunk = "";
        if (string.IsNullOrWhiteSpace(text)) return false;
        var t = text.Trim();
        var stableMs = (nowUtc - _activeLastChangedAt).TotalMilliseconds;
        bool stableReady = stableMs >= ActiveFallbackStableMs;
        bool nonLatin = ContainsNonLatinScript(t);

        if (nonLatin)
        {
            bool shouldChunk =
                (stableReady && (t.Length >= ActiveFallbackNonLatinHardCapChars || EndsAtSemanticBoundary(t)))
                || stableMs >= ActiveFallbackMaxAgeMs;
            if (!shouldChunk) return false;
            int take = Math.Min(ActiveFallbackNonLatinChunkChars, t.Length);
            chunk = t[..take].Trim();
            text = t[take..].TrimStart();
            return !string.IsNullOrWhiteSpace(chunk);
        }

        int wc = WordCount(t);
        bool shouldFallback =
            (stableReady && wc >= ActiveFallbackHardCapWords)
            || (stableReady && wc >= ActiveFallbackChunkWords && EndsAtSemanticBoundary(t))
            || (wc >= ActiveFallbackMinWords && stableMs >= ActiveFallbackMaxAgeMs);
        if (!shouldFallback) return false;

        var words = t.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        int takeWords = Math.Min(ActiveFallbackChunkWords, words.Length);
        if (takeWords < ActiveFallbackMinWords) return false;
        chunk = string.Join(" ", words, 0, takeWords).Trim();
        text = words.Length > takeWords
            ? string.Join(" ", words, takeWords, words.Length - takeWords).Trim()
            : "";
        return !string.IsNullOrWhiteSpace(chunk);
    }

    private static string NormalizeWordForCompare(string word) =>
        word.Trim().Trim(',', '.', ';', ':', '?', '!', '"', '\'');

    private static bool IsNearDuplicate(string a, string b, double threshold = 0.88)
    {
        var na = NormalizeForDisplay(a);
        var nb = NormalizeForDisplay(b);
        bool nonLatin = ContainsNonLatinScript(a) || ContainsNonLatinScript(b);
        if (na == nb) return true;
        if (na.Length < 4 || nb.Length < 4) return false;
        if (na.StartsWith(nb) || nb.StartsWith(na)) return true;
        if (nonLatin)
        {
            if (na.Contains(nb) || nb.Contains(na))
            {
                var shorter = Math.Min(na.Length, nb.Length);
                var longer  = Math.Max(na.Length, nb.Length);
                if (longer > 0 && (double)shorter / longer >= NonLatinContainmentRatioThreshold) return true;
            }

            if (na.Length <= NonLatinLcsMaxChars && nb.Length <= NonLatinLcsMaxChars)
            {
                var lcs = LongestCommonSubstringLength(na, nb);
                var denom = Math.Min(na.Length, nb.Length);
                if (denom > 0 && (double)lcs / denom >= threshold) return true;
            }
        }
        // For non-Latin scripts WordCount is misleading — use char-level similarity
        int min = Math.Min(na.Length, nb.Length), same = 0;
        for (int i = 0; i < min; i++) if (na[i] == nb[i]) same++;
        return (double)same / Math.Max(na.Length, nb.Length) >= threshold;
    }

    private static int LongestCommonSubstringLength(string a, string b)
    {
        if (string.IsNullOrEmpty(a) || string.IsNullOrEmpty(b)) return 0;
        var dp = new int[b.Length + 1];
        int best = 0;
        for (int i = 1; i <= a.Length; i++)
        {
            int prev = 0;
            for (int j = 1; j <= b.Length; j++)
            {
                int tmp = dp[j];
                if (a[i - 1] == b[j - 1])
                {
                    dp[j] = prev + 1;
                    if (dp[j] > best) best = dp[j];
                }
                else
                {
                    dp[j] = 0;
                }
                prev = tmp;
            }
        }
        return best;
    }

    private static bool IsLikelyRevisionOf(string existing, string text)
    {
        // Non-Latin scripts don't use spaces as word boundaries — use IsNearDuplicate instead
        if (ContainsNonLatinScript(existing) || ContainsNonLatinScript(text))
            return IsNearDuplicate(existing, text, 0.75);
        var ew = existing.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var tw = text.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (ew.Length < 6 || tw.Length < 6) return false;
        int shared = 0, maxCheck = Math.Min(ew.Length, tw.Length);
        for (int i = 0; i < maxCheck; i++)
        {
            if (string.Equals(NormalizeWordForCompare(ew[i]),
                NormalizeWordForCompare(tw[i]),
                StringComparison.OrdinalIgnoreCase)) shared++;
            else break;
        }
        return shared >= 6 && (double)shared / Math.Min(ew.Length, tw.Length) >= 0.55;
    }

    private static string NormalizeForDisplay(string text)
    {
        var sb = new System.Text.StringBuilder();
        bool prevSpace = false;
        foreach (var c in text.ToLowerInvariant())
        {
            // Preserve letters (including non-Latin scripts), digits, and collapse whitespace
            if (char.IsLetter(c) || char.IsDigit(c)) { sb.Append(c); prevSpace = false; }
            else if (char.IsWhiteSpace(c) && !prevSpace) { sb.Append(' '); prevSpace = true; }
        }
        return sb.ToString().Trim();
    }

    public async ValueTask DisposeAsync()
    {
        _scrollDebounce?.Cancel();
        _scrollDebounce?.Dispose();
        lock (_committedQueueLock)
        {
            _disposeCts.Cancel();
            _committedQueue.Clear();
            _draining = false;
        }
        if (_hub is not null)
        {
            await _hub.SendAsync("LeaveMeeting", _meetingId);
            await _hub.DisposeAsync();
        }
    }
}
